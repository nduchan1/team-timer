{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        "timer": {
          ".read": "$room.matches(/^[A-Za-z0-9_-]{22}$/)",
          ".write": "$room.matches(/^[A-Za-z0-9_-]{22}$/) && newData.exists() && (!data.exists() || now - data.child('updatedAt').val() > 100)",
          ".validate": "newData.hasChildren(['v', 'running', 'intervalMs', 'anchorMs', 'loopBase', 'updatedAt', 'updatedBy', 'action']) && newData.child('updatedAt').val() == now && ((!data.exists() && newData.child('v').val() == 1) || (data.exists() && newData.child('v').val() == data.child('v').val() + 1))",
          "v": { ".validate": "newData.isNumber()" },
          "running": { ".validate": "newData.isBoolean()" },
          "intervalMs": { ".validate": "newData.isNumber() && newData.val() >= 10000 && newData.val() <= 86400000" },
          "anchorMs": { ".validate": "newData.isNumber() && newData.val() > now - 2592000000 && newData.val() < now + 90000000" },
          "loopBase": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000000" },
          "pausedRemainingMs": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400000" },
          "startedAtMs": { ".validate": "newData.isNumber() && newData.val() > now - 31536000000 && newData.val() < now + 90000000" },
          "prevZeroMs": { ".validate": "newData.isNumber() && newData.val() > now - 2592000000 && newData.val() < now + 60000" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "updatedBy": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
          "action": { ".validate": "newData.isString() && newData.val().matches(/^(create|start|stop|resume|raided|nudge|interval)$/)" },
          "$other": { ".validate": false }
        },
        "chat": {
          ".read": "$room.matches(/^[A-Za-z0-9_-]{22}$/)",
          ".indexOn": ["at"],
          "$msg": {
            ".write": "$room.matches(/^[A-Za-z0-9_-]{22}$/) && $msg.matches(/^[A-Za-z0-9_-]{20}$/) && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 'at']) && newData.child('at').val() == now && newData.parent().parent().child('chatLast/id').val() == $msg && newData.parent().parent().child('chatLast/at').val() == now && (!data.parent().parent().child('chatLast/at').exists() || now - data.parent().parent().child('chatLast/at').val() > 200)",
            "uid": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{22}$/)" },
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
            "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "chatLast": {
          ".write": "$room.matches(/^[A-Za-z0-9_-]{22}$/) && newData.exists()",
          ".validate": "newData.hasChildren(['at', 'id']) && newData.child('at').val() == now && newData.child('id').isString() && newData.parent().child('chat').child(newData.child('id').val()).exists() && !data.parent().child('chat').child(newData.child('id').val()).exists()",
          "at": { ".validate": "newData.isNumber()" },
          "id": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        },
        "presence": {
          ".read": "$room.matches(/^[A-Za-z0-9_-]{22}$/)",
          "$cid": {
            ".write": "$room.matches(/^[A-Za-z0-9_-]{22}$/) && $cid.matches(/^[A-Za-z0-9_-]{22}$/)",
            ".validate": "newData.hasChildren(['name', 'onDuty', 'since']) && newData.child('since').val() == now",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
            "onDuty": { ".validate": "newData.isBoolean()" },
            "since": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "reminders": {
          ".read": "$room.matches(/^[A-Za-z0-9_-]{22}$/)",
          "$id": {
            ".write": "$room.matches(/^[A-Za-z0-9_-]{22}$/) && $id.matches(/^(artwork|r[0-9]{1,2})$/)",
            ".validate": "newData.hasChildren(['label', 'by', 'at', 't']) && newData.child('at').val() == now && newData.child('t').val() > now - 60000 && newData.child('t').val() < now + 60000",
            "label": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "dueAt": { ".validate": "newData.isNumber() && newData.val() > now - 86400000 && newData.val() < now + 604800000" },
            "restartMs": { ".validate": "newData.isNumber() && newData.val() >= 60000 && newData.val() <= 172800000" },
            "usedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "usedBy": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
            "firedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "firedBy": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
            "by": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
            "at": { ".validate": "newData.isNumber()" },
            "t": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "oasisIndex": {
          ".read": "$room.matches(/^[A-Za-z0-9_-]{22}$/)",
          "$w": {
            ".write": "$room.matches(/^[A-Za-z0-9_-]{22}$/) && $w.matches(/^[a-z0-9_-]{3,60}$/) && newData.exists() && (!data.exists() || now - data.child('at').val() > 60000)",
            ".validate": "newData.hasChildren(['world', 'serverUrl', 'scannedAt', 'count', 'by', 'at']) && newData.child('at').val() == now && newData.parent().parent().child('oasisData').child($w).isString()",
            "world": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
            "serverUrl": { ".validate": "newData.isString() && newData.val() == 'https://' + $w.replace('_', '.') + '.travian.com'" },
            "scannedAt": { ".validate": "newData.isNumber() && newData.val() > 1500000000000 && newData.val() <= now + 86400000" },
            "count": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 60000" },
            "by": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "farm": {
          "$w": {
            ".read": "$room.matches(/^[A-Za-z0-9_-]{22}$/) && $w.matches(/^[a-z0-9_-]{3,60}$/)",
            "villages": {
              ".write": "$room.matches(/^[A-Za-z0-9_-]{22}$/) && $w.matches(/^[a-z0-9_-]{3,60}$/) && newData.exists()",
              ".validate": "newData.hasChildren(['list', 'by', 'at']) && newData.child('at').val() == now",
              "list": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 6000" },
              "by": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
              "at": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            },
            "lists": {
              "$lk": {
                ".write": "$room.matches(/^[A-Za-z0-9_-]{22}$/) && $w.matches(/^[a-z0-9_-]{3,60}$/) && $lk.matches(/^-?[0-9]{1,3}_-?[0-9]{1,3}_[0-9a-z]{1,7}$/)",
                ".validate": "newData.hasChildren(['v', 'vx', 'vy', 'n', 'total', 'by', 'at']) && newData.child('at').val() == now",
                "v": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
                "vx": { ".validate": "newData.isNumber() && newData.val() >= -999 && newData.val() <= 999" },
                "vy": { ".validate": "newData.isNumber() && newData.val() >= -999 && newData.val() <= 999" },
                "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
                "total": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200" },
                "known": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200" },
                "oases": { ".validate": "newData.isString() && newData.val().length <= 2200 && newData.val().matches(/^[-0-9|,]*$/)" },
                "by": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
                "at": { ".validate": "newData.isNumber()" },
                "$other": { ".validate": false }
              }
            },
            "marks": {
              "$k": {
                ".write": "$room.matches(/^[A-Za-z0-9_-]{22}$/) && $w.matches(/^[a-z0-9_-]{3,60}$/) && $k.matches(/^-?[0-9]{1,3}_-?[0-9]{1,3}$/)",
                ".validate": "newData.hasChildren(['vx', 'vy', 'by', 'at']) && newData.child('at').val() == now",
                "vx": { ".validate": "newData.isNumber() && newData.val() >= -999 && newData.val() <= 999" },
                "vy": { ".validate": "newData.isNumber() && newData.val() >= -999 && newData.val() <= 999" },
                "by": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
                "at": { ".validate": "newData.isNumber()" },
                "$other": { ".validate": false }
              }
            }
          }
        },
        "oasisData": {
          "$w": {
            ".read": "$room.matches(/^[A-Za-z0-9_-]{22}$/)",
            ".write": "$room.matches(/^[A-Za-z0-9_-]{22}$/) && $w.matches(/^[a-z0-9_-]{3,60}$/) && newData.exists()",
            ".validate": "newData.isString() && newData.val().length >= 50 && newData.val().length <= 2000000 && newData.parent().parent().child('oasisIndex').child($w).child('at').val() == now"
          }
        }
      }
    },
    "clock": {
      "$cid": {
        ".read": "$cid.matches(/^[A-Za-z0-9_-]{22}$/)",
        ".write": "$cid.matches(/^[A-Za-z0-9_-]{22}$/) && (!newData.exists() || newData.val() == now)"
      }
    }
  }
}
