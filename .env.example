# Firebase web-app config (Firebase console → Project settings → Your apps → Web app).
# These are public identifiers; database.rules.json is what protects the data.
# Copy to .env.local for `npm run dev`, and add the same four to Vercel (vercel env add …).
# Without them the app runs in local mode (tabs of one browser only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=https://<project>-default-rtdb.europe-west1.firebasedatabase.app
